API_DEBUG=1
LOG_LEVEL=INFO
APP_CONFIG_FILE=
IMAGE_BASE_DIR=.
COMPARE_TMP_DIR=.compare_tmp
MODEL_CACHE_DIR=models

COMPARE_MAX_FILE_SIZE_BYTES=10485760
COMPARE_MAX_TOTAL_UPLOAD_BYTES=20971520
COMPARE_ALLOWED_IMAGE_FORMATS=png,jpeg,webp
COMPARE_MAX_IMAGE_SIDE=8192
COMPARE_MAX_IMAGE_PIXELS=40000000
COMPARE_RATE_LIMIT_ENABLED=false
COMPARE_RATE_LIMIT_CREATE_LIMIT=60
COMPARE_RATE_LIMIT_CREATE_WINDOW_SEC=60
COMPARE_RATE_LIMIT_READ_LIMIT=240
COMPARE_RATE_LIMIT_READ_WINDOW_SEC=60

JOB_STORE_BACKEND=redis
# Shared Redis settings (used by API, JobStore, and Celery broker/backend).
REDIS_HOST=10.21.69.238
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=qa-test-ml
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_PREFIX=pms
REDIS_STARTUP_CHECK_MODE=ping
JOB_RETENTION_SEC=86400

CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_ACKS_LATE=true

COMPARE_QUEUE_CPU=compare-cpu
COMPARE_QUEUE_GPU=compare-gpu
ENABLE_GPU_QUEUE=false
COMPARE_EXECUTION_DEVICE=auto

PROMETHEUS_WORKER_ENABLED=false
PROMETHEUS_WORKER_ADDR=0.0.0.0
PROMETHEUS_WORKER_PORT=9101
PROMETHEUS_MULTIPROC_DIR=/tmp/pms-prom-worker

LOG_API_ENABLED=false
LOG_API_URL=
LOG_API_LEVEL=ERROR
LOG_API_TIMEOUT_MS=2000
LOG_API_TOKEN=
LOG_SERVICE_NAME=perceptual-metrics-service

HMAC_ENABLED=false
HMAC_SECRET=
HMAC_ALLOWED_SKEW_SEC=300
HMAC_REQUIRE_NONCE=true
HMAC_NONCE_TTL_SEC=300

APP_GIT_BRANCH=
APP_GIT_TAG=
APP_GIT_LAST_COMMIT=
APP_GIT_COMMITTER=
APP_GIT_COMMIT_DATE=

API_WORKERS=2
CELERY_CPU_CONCURRENCY=2
CELERY_GPU_CONCURRENCY=1
CELERY_LOG_LEVEL=INFO

# External Redis examples:
# REDIS_HOST=redis.example.com
# REDIS_PORT=6380
# REDIS_DB=0
# REDIS_USERNAME=svc-user
# REDIS_PASSWORD=svc-password
# REDIS_TLS=true

# Optional local integration-test helpers (tests/test_redis_auth_integration.py)
RUN_REDIS_INTEGRATION=0
PMS_REDIS_AUTH_URL=redis://:pms-secret@127.0.0.1:6380/0

# Local auth-enabled Redis example (dev/test only):
# REDIS_HOST=redis-auth
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=pms-secret
